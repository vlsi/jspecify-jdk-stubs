{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the tip of jspecify/jdk main",
      "managerFilePatterns": ["/^versions\\.env$/"],
      "matchStrings": ["JSPECIFY_JDK_SHA=(?<currentDigest>[0-9a-f]{40})"],
      "depNameTemplate": "jspecify/jdk",
      "packageNameTemplate": "https://github.com/jspecify/jdk.git",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Track the newest generally available Java major in jdkBuildVersion. The datasource returns versions such as 28.0.1+9; extractVersion keeps the major, so Renovate writes 28 when the next major ships and ignores 27.0.x updates.",
      "managerFilePatterns": ["/^gradle\\.properties$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+jdkBuildVersion=(?<currentValue>\\d+)"
      ],
      "extractVersionTemplate": "^(?<version>\\d+)"
    },
    {
      "customType": "regex",
      "description": "Track the newest LTS Java major that runs Gradle",
      "managerFilePatterns": ["/^gradle/gradle-daemon-jvm\\.properties$/"],
      "matchStrings": ["toolchainVersion=(?<currentValue>\\d+)"],
      "depNameTemplate": "java-lts",
      "packageNameTemplate": "java-jdk",
      "datasourceTemplate": "java-version",
      "versioningTemplate": "regex:^(?<major>\\d+)",
      "extractVersionTemplate": "^(?<version>\\d+)"
    }
  ],
  "packageRules": [
    {
      "description": "An LTS release ships every two years: 21, 25, and every fourth major after them",
      "matchDepNames": ["java-lts"],
      "allowedVersions": "/^(25|29|33|37|41|45|49)(\\.|$)/"
    }
  ]
}
